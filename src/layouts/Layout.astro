---
import '../index.css';
import { initialSiteSettings } from '../data/initialData';
import siteSettings from '../data/siteSettings.json';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  robotsDirective?: string;
  schemaData?: any;
}

const resolvedSiteSettings = siteSettings || initialSiteSettings;

const siteTitle = resolvedSiteSettings.siteTitle ?? initialSiteSettings.siteTitle;
const siteUrl = resolvedSiteSettings.siteUrl ?? initialSiteSettings.siteUrl ?? 'https://astropress.pages.dev';

const profiles = resolvedSiteSettings.seoSocialProfiles || initialSiteSettings.seoSocialProfiles || {};
const twitterHandle = profiles.twitterHandle ?? '@astropress';

const defaultOgImage = resolvedSiteSettings.defaultOgImage ?? initialSiteSettings.defaultOgImage;

const {
  title = `${siteTitle} — ${resolvedSiteSettings.siteTagline ?? initialSiteSettings.siteTagline}`,
  description = resolvedSiteSettings.siteDescription ?? initialSiteSettings.siteDescription,
  ogImage = defaultOgImage,
  canonicalUrl = Astro.url ? Astro.url.href : siteUrl,
  robotsDirective = "index, follow",
  schemaData,
} = Astro.props;

const sameAsUrls = [
  profiles.facebookUrl,
  profiles.instagramUrl,
  profiles.youtubeUrl,
  profiles.linkedinUrl,
  profiles.githubUrl,
  profiles.twitterHandle ? `https://x.com/${profiles.twitterHandle.replace(/^@/, '')}` : undefined,
].filter(Boolean);

const siteLogoUrl = resolvedSiteSettings.logoUrl ?? initialSiteSettings.logoUrl;
const siteFaviconUrl = resolvedSiteSettings.faviconUrl ?? initialSiteSettings.faviconUrl ?? '/favicon.ico';

const organizationSchema: any = {
  '@type': 'Organization',
  '@id': `${siteUrl}#organization`,
  name: siteTitle,
  url: siteUrl,
  description: description,
  sameAs: sameAsUrls.length > 0 ? sameAsUrls : undefined,
};
if (siteLogoUrl) {
  organizationSchema.logo = {
    '@type': 'ImageObject',
    url: siteLogoUrl,
  };
}

const defaultSchemaGraph = schemaData || {
  '@context': 'https://schema.org',
  '@graph': [
    organizationSchema,
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: siteTitle,
      description: description,
      publisher: { '@id': `${siteUrl}#organization` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${siteUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: siteUrl,
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsDirective} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={siteFaviconUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content={twitterHandle} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script type="application/ld+json" id="astropress-schema" set:html={JSON.stringify(defaultSchemaGraph, null, 2)} />
    
    <!-- Fetch & Sandbox compatibility guard -->
    <script is:inline>
      (function() {
        try {
          // Suppress Vite HMR / WebSocket send before connect warnings in sandboxed iframes
          var origError = console.error;
          console.error = function() {
            var msg = arguments[0];
            if (typeof msg === 'string' && (msg.includes('send was called before connect') || msg.includes('WebSocket') || msg.includes('vite:ws'))) {
              return;
            }
            origError.apply(console, arguments);
          };
          var origWarn = console.warn;
          console.warn = function() {
            var msg = arguments[0];
            if (typeof msg === 'string' && (msg.includes('send was called before connect') || msg.includes('WebSocket') || msg.includes('vite:ws'))) {
              return;
            }
            origWarn.apply(console, arguments);
          };

          // Guard against "Cannot set property fetch of #<Window> which has only a getter"
          var nativeFetch = window.fetch;
          var activeFetch = nativeFetch ? function() { return nativeFetch.apply(window, arguments); } : undefined;
          if (typeof Window !== 'undefined' && Window.prototype) {
            var protoDesc = Object.getOwnPropertyDescriptor(Window.prototype, 'fetch');
            if (protoDesc && !protoDesc.set && protoDesc.configurable) {
              Object.defineProperty(Window.prototype, 'fetch', {
                get: function() { return activeFetch; },
                set: function(fn) { activeFetch = typeof fn === 'function' ? fn : nativeFetch; },
                configurable: true,
                enumerable: true
              });
            }
          }
          Object.defineProperty(window, 'fetch', {
            get: function() { return activeFetch; },
            set: function(fn) { activeFetch = typeof fn === 'function' ? fn : nativeFetch; },
            configurable: true,
            enumerable: true
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800 antialiased font-sans">
    <slot />
  </body>
</html>
